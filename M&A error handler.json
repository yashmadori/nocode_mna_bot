        "jsCode": "const e = $input.first().json;\nconst ex = e.execution || {};\nconst wf = e.workflow || {};\nconst err = ex.error || e.trigger?.error || {};\n\nconst message = (err.message || 'Unknown error').slice(0, 500);\nconst node = ex.lastNodeExecuted || 'n/a';\n\nconst text = [\n  'n8n workflow failed',\n  `Workflow: ${wf.name || 'n/a'}`,\n  `Node: ${node}`,\n  `Error: ${message}`,\n  `Execution: ${ex.url || ex.id || 'n/a'}`,\n  `Time: ${new Date().toISOString()}`\n].join('\\n');\n\nreturn [{ json: { workflow: wf.name || '', node, message, execution_url: ex.url || '', text } }];"
