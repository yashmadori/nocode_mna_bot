    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT a.title, a.url, a.published_at, a.is_ma,\n       d.acquirer, d.target, d.value_m, d.currency,\n       count(*) OVER ()                         AS total_articles,\n       count(*) FILTER (WHERE a.is_ma) OVER ()  AS ma_articles\nFROM articles a\nLEFT JOIN deals d ON d.id = a.deal_id\nWHERE a.processed_at >= now() - interval '24 hours'\nORDER BY a.is_ma DESC NULLS LAST, a.published_at DESC\nLIMIT 25;",
        "options": {}
      },
