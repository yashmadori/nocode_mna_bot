    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT to_char(date_trunc('month', COALESCE(announced_date, first_seen::date)), 'YYYY-MM') AS month,\n       count(*) AS deals,\n       array_to_string((array_agg(acquirer || ' → ' || target ORDER BY value_m DESC NULLS LAST))[1:3], '; ') AS examples\nFROM deals\nWHERE (acquirer ~* $1 OR target ~* $1 OR target_description ~* $1 OR rationale ~* $1)\n  AND COALESCE(announced_date, first_seen::date) >= current_date - interval '12 months'\nGROUP BY 1\nORDER BY 1;",
        "options": {
          "queryReplacement": "={{ [$json.pattern] }}"
        }
