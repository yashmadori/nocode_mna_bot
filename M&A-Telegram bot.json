    {
      "parameters": {
        "jsCode": "const msg = $input.first().json.message || {};\nconst text = String(msg.text || '').trim();\n\n// \"/company@MyBot EQT\"  ->  command = \"company\", arg = \"EQT\"\nconst m = text.match(/^\\/(\\w+)(?:@\\w+)?\\s*([\\s\\S]*)$/);\nlet command = m ? m[1].toLowerCase() : '';\nlet arg = m ? m[2].trim().slice(0, 60) : '';\nlet note = '';\n\nconst needsArg = ['deals', 'company', 'trend'];\nconst example = { deals: 'cybersecurity', company: 'Microsoft', trend: 'AI' };\n\nif (!m) {\n  note = 'I only understand commands.';\n  command = 'help';\n} else if (needsArg.includes(command) && !arg) {\n  note = `Please add a keyword, e.g. /${command} ${example[command]}`;\n  command = 'help';\n} else if (!needsArg.includes(command) && command !== 'news') {\n  command = 'help';\n}\n\n// Whole-word search pattern for Postgres: \"AI\" matches \"AI\", not \"Spain\" or \"said\"\nconst escaped = arg.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\nconst pattern = `\\\\m${escaped}\\\\M`;\n\nreturn [{ json: {\n  chat_id: msg.chat?.id,\n  first_name: msg.from?.first_name || '',\n  command,\n  arg,\n  pattern,\n  note,\n}}];"
      },
      "type": "n8n-nodes-base.code",
