      "parameters": {
        "chatId": "={{ $json.chat_id }}",
        "text": "=  {{ $json.note ? $json.note + '\\n\\n' : '' }}M&A deal tracker — commands:\n  /deals <keyword> — deals matching a keyword (e.g. /deals cybersecurity)\n  /company <name> — deals where a company is buyer or target (e.g. /company EQT)\n  /trend <keyword> — number of deals per month (e.g. /trend AI)\n/news — overview of articles processed in the last 24 hours",
