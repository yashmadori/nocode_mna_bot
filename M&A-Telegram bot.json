    {
      "parameters": {
        "jsCode": "const ctx = $('Parse command').first().json;\n\n// Remove the empty item created by \"Always Output Data\" when there are no results\nconst rows = $input.all()\n  .map(i => i.json)\n  .filter(r => Object.keys(r).length > 0 && !(Object.keys(r).length === 1 && 'success' in r));\n\nreturn [{ json: {\n  command: ctx.command,\n  arg: ctx.arg,\n  chat_id: ctx.chat_id,\n  count: rows.length,\n  rows: JSON.stringify(rows),\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        992,
        -64
