    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  (SELECT count(*) FROM articles WHERE processed_at >= $1::timestamptz)               AS new_articles,\n  (SELECT count(*) FROM articles WHERE processed_at >= $1::timestamptz AND is_ma)     AS ma_articles,\n  (SELECT count(*) FROM deals WHERE first_seen >= $1::timestamptz)                    AS new_deals,\n  (SELECT count(*) FROM deals WHERE last_seen >= $1::timestamptz\n                                AND first_seen < $1::timestamptz)                     AS updated_deals,\n  (SELECT count(*) FROM deals)                                                        AS total_deals;",
        "options": {
          "queryReplacement": "={{ [ $('Start run').first().json.run_started ] }}"
        }
